"""Standalone executable entry point for cda2pdf."""

import os
import sys

# Prepend ../src so this script works immediately even before `pip install -e .`
ROOT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SRC_DIR = os.path.join(ROOT_DIR, "src")
if SRC_DIR not in sys.path:
    sys.path.insert(0, SRC_DIR)

from cda2pdf.cli import main

if __name__ == "__main__":
    sys.exit(main())
